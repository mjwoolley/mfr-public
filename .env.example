# Neon Postgres — pooled connection (runtime) and direct connection (migrations)
DATABASE_URL=
DIRECT_URL=

# Auth.js — generate AUTH_SECRET with: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of emails that get the ADMIN role on first sign-in
ADMIN_EMAILS=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

APP_BASE_URL=http://localhost:3000
