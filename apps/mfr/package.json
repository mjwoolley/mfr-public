{
  "name": "mfr_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "COVERAGE_UNIT_ONLY=1 vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:mutation": "stryker run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node scripts/migrate-deploy.mjs",
    "vercel-build": "node scripts/migrate-deploy.mjs && next build"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md}": "prettier --write"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-sesv2": "^3.1087.0",
    "@mfr/auth": "*",
    "@mfr/ui": "*",
    "@paralleldrive/cuid2": "^2.2.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/blob": "^2.6.1",
    "@vercel/microfrontends": "^2.4.0",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.32",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^3.9.2",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
