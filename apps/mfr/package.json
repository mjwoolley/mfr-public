{
  "name": "mfr_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "COVERAGE_UNIT_ONLY=1 vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node scripts/migrate-deploy.mjs",
    "vercel-build": "node scripts/migrate-deploy.mjs && next build"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md}": "prettier --write"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/client-sesv2": "^3.1160.0",
    "@mfr/auth": "*",
    "@mfr/ui": "*",
    "@paralleldrive/cuid2": "^2.2.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@tanstack/react-query": "^5.105.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/microfrontends": "^2.4.2",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.45.4",
    "exifr": "^7.1.3",
    "google-auth-library": "^10.9.0",
    "heic-convert": "^2.1.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pino": "^10.4.0",
    "postal-mime": "2.7.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
