# The single unified database (Neon). All clients — business data, portal
# feature tables, and the @mfr/auth identity tables — read DATABASE_URL.
# Use the pooled (pgbouncer) connection string for the runtime app.
DATABASE_URL=
# Direct (non-pooled) connection — only needed for `drizzle-kit push` schema
# deploys (npm run db:push -w apps/mfr).
DIRECT_URL=

# Auth.js / Google OAuth. AUTH_SECRET signs the session cookie.
AUTH_SECRET=
# Base URL of the auth routes. Locally the app runs on port 3002.
AUTH_URL=http://localhost:3002/api/auth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Photo-gallery backup (Cloudflare R2, S3-compatible). Every uploaded photo is
# mirrored here for durability. Real writes only when BACKUP_ENABLED=true
# (production) — mirrors the EMAIL_ENABLED guard, so local/test never touch R2.
# R2_* use custom names because Vercel reserves the AWS_* names for its runtime.
BACKUP_ENABLED=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Shared secret Vercel Cron sends as `Authorization: Bearer` to the backup cron.
# Also gates GET /api/health (deep smoke check: DB + R2 round-trip).
CRON_SECRET=
# Standing session token for the seeded smoke-test user (scripts/seed-smoke-user
# + scripts/smoke). It is a LOGIN CREDENTIAL — treat like a password, keep it a
# secret (Vercel/CI), rotate if leaked. Only needed to run the signed-in smoke.
SMOKE_SESSION_TOKEN=

# Google Drive service-account key for the Documents page. The site reads the
# shared Drive folder on every member's behalf, so members are never invited to
# the Drive — only editors are. Create a service account, enable the Drive API,
# download its JSON key, and share the root folder with the service account's
# email as Viewer. Value is the JSON key (or its base64 encoding). Server-only.
GOOGLE_DRIVE_SA_KEY=

# Integration test database (a dedicated Neon `test` branch — the test setup
# TRUNCATES it; never point these at real data). Pooled + direct URLs for the
# same branch. Load these before running `npx vitest run`.
TEST_DATABASE_URL=
TEST_DIRECT_URL=
