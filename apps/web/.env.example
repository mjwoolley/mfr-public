# Portal database (mfr-portal) — this app's own business data: portal roles,
# settings, photo albums, events, meal RSVPs. Pooled connection for runtime;
# the direct connection is only needed for `drizzle-kit push` schema deploys.
# PORTAL_DATABASE_URL must be the same value across all three apps (they read
# roles from it).
PORTAL_DATABASE_URL=
PORTAL_DIRECT_DATABASE_URL=

# Shared identity database (see @mfr/auth) — same value across every app.
IDENTITY_DATABASE_URL=

# Auth.js / Google OAuth — shared across all mfr apps (see @mfr/auth).
# AUTH_SECRET must be the IDENTICAL string everywhere for shared sessions.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Cross-app SSO cookie domain (.millerfamilyreunions.org in prod); unset for
# local dev — host-only cookies are fine on localhost.
AUTH_COOKIE_DOMAIN=
# Overrides the session cookie name. Leave unset in production. Set on any
# environment that shares a registrable domain with prod (e.g. staging under
# .staging.millerfamilyreunions.org) so prod's cookie isn't read as its session.
AUTH_SESSION_COOKIE_NAME=

# Staging only: Vercel Deployment Protection bypass token, sent when the home
# page's fundraising card fetches accounting's public API server-to-server
# (protection would otherwise 401 it). Unset in production and local dev.
ACCOUNTING_BYPASS_SECRET=

# Integration test databases (dedicated Neon `test` branches — the test setup
# TRUNCATES these; never point them at real data).
TEST_PORTAL_DATABASE_URL=
TEST_IDENTITY_DATABASE_URL=

# --- Cross-environment (staging) ---
# Cross-app navigation links. Unset = production defaults. A non-prod deploy
# (staging) points these at its own hosts so nav doesn't bounce back to prod.
NEXT_PUBLIC_HOME_URL=
NEXT_PUBLIC_RESERVATIONS_URL=
NEXT_PUBLIC_ACCOUNTING_URL=
