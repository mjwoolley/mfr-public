# Auth.js / Google OAuth — shared across all mfr_* apps (see @mfr/auth)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# Unset for local dev / same-origin proxy routing; '.millerfamilyreunions.org'
# once subdomain-based routing is in place.
AUTH_COOKIE_DOMAIN=
# Overrides the session cookie name. Leave unset in production. Set on any
# environment that shares a registrable domain with prod (e.g. staging under
# .staging.millerfamilyreunions.org) so prod's cookie isn't read as its session.
AUTH_SESSION_COOKIE_NAME=

# Shared identity database (see @mfr/auth) — same value across every app
IDENTITY_DATABASE_URL=
IDENTITY_DIRECT_DATABASE_URL=

# Portal database (mfr-portal) — pooled connection. Required at runtime: the
# shared session callback reads portal roles from here (reservations admin =
# site manager or site owner), and notifications resolve which users to CC from
# it. Same value across all three apps.
PORTAL_DATABASE_URL=

# Database — Neon Postgres pooled connection string (this app's own business data)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Integration test database (dedicated Neon branch)
TEST_DATABASE_URL=
TEST_DIRECT_DATABASE_URL=
TEST_IDENTITY_DATABASE_URL=
TEST_IDENTITY_DIRECT_DATABASE_URL=
# Portal test DB (mfr-portal `test` branch) — the notifications integration
# test resolves CC'd admins from portal roles, so it needs this seeded.
TEST_PORTAL_DATABASE_URL=

# Email — Amazon SES. Vercel reserves the AWS_* env names, hence the SES_
# prefix; the values come from an IAM user scoped to ses:SendEmail.
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Verified SES sender address, e.g. reservations@millerfamilyreunions.org
EMAIL_FROM=
# Set EMAIL_ENABLED=true ONLY in production — it lets sendEmail() deliver to
# real recipients. Leave it unset everywhere else.
EMAIL_ENABLED=
# In non-prod (EMAIL_ENABLED unset), all mail — including cc'd admins — is
# redirected to a plus sub-address of this inbox so real members are never
# emailed from dev: a message for dbrown@gmail.com with
# EMAIL_OVERRIDE_TO=me@gmail.com is sent to me+dbrown=gmail.com@gmail.com.
# Needs a "+"-addressing inbox (Gmail). Blank in prod.
EMAIL_OVERRIDE_TO=
# Absolute base URL used to build links inside notification emails — must
# include the /reservations path prefix (mirrors accounting's APP_BASE_URL).
APP_BASE_URL=http://localhost:3000/reservations

# Cron authentication (Milestone 8)
CRON_SECRET=

# Technical logging (optional, defaults to "info")
LOG_LEVEL=

# --- Cross-environment (staging) ---
# Cross-app navigation links. Unset = production defaults. A non-prod deploy
# (staging) points these at its own hosts so nav doesn't bounce back to prod.
NEXT_PUBLIC_HOME_URL=
NEXT_PUBLIC_RESERVATIONS_URL=
NEXT_PUBLIC_ACCOUNTING_URL=
# Extra allowed server-action origins beyond the production hosts, comma-
# separated (e.g. the staging subdomain). Unset in production.
ADDITIONAL_ALLOWED_ORIGINS=
