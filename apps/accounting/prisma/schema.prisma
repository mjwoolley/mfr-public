// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity ----------
//
// Users/accounts/sessions/verification_tokens now live in the shared @mfr/auth
// identity database (a separate Neon project). Postgres has no cross-database
// foreign keys, so the columns below that logically reference an identity user
// (Shareholder.userId, Transaction.createdById) are plain, unconstrained
// strings holding an identity `users.id` (a uuid) — not real relations.

// ---------- Domain model ----------

model Shareholder {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Logical link to the shared identity DB's users.id — set by the auth
  // extendSession hook on first sign-in by email match. No FK (cross-database).
  userId String? @unique

  ledgerEntries LedgerEntry[]
  approvals     TransactionApproval[]
}

enum TransactionType {
  CONTRIBUTION
  TRANSFER
  ADJUSTMENT
  CORRECTION
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())

  // Logical link to the identity DB's users.id (no cross-database FK), plus a
  // denormalized snapshot of the recording admin's name/email captured at write
  // time — the source of truth for "Recorded by …" since a runtime join into
  // the separate identity database isn't possible. Immune to later name changes.
  createdById    String
  createdByName  String?
  createdByEmail String?

  correctsTransactionId String?
  correctsTransaction    Transaction?  @relation("Corrections", fields: [correctsTransactionId], references: [id])
  correctedBy            Transaction[] @relation("Corrections")

  entries    LedgerEntry[]
  approvals  TransactionApproval[]

  @@index([type])
  @@index([correctsTransactionId])
}

model LedgerEntry {
  id            String   @id @default(cuid())
  transactionId String
  shareholderId String
  shares        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  shareholder Shareholder @relation(fields: [shareholderId], references: [id])

  @@index([shareholderId])
  @@index([transactionId])
}

enum ApprovalStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

model TransactionApproval {
  id            String         @id @default(cuid())
  transactionId String
  shareholderId String
  status        ApprovalStatus @default(PENDING)
  confirmedAt   DateTime?
  disputedAt    DateTime?
  disputeReason String?
  resolvedAt    DateTime?

  // Optional, informational-only pointer to the CORRECTION transaction that
  // resolved this dispute (if any) — same "no cross-model enforcement"
  // pattern as Transaction.correctsTransactionId. A dispute never silently
  // reverts to CONFIRMED once resolved; status stays DISPUTED with
  // resolvedAt/resolutionTransactionId set, preserving the audit trail.
  resolutionTransactionId String?

  createdAt DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  shareholder Shareholder @relation(fields: [shareholderId], references: [id])

  @@unique([transactionId, shareholderId])
  @@index([shareholderId])
}

enum ExpenseCategory {
  TAXES
  INSURANCE
  UTILITIES
  FURNISHINGS
  REPAIRS
  IMPROVEMENTS
  OTHER
}

// Admin-recorded expenses, tracked separately from the share-ownership
// ledger (Transaction/LedgerEntry) since an expense isn't a share
// transaction. Unlike the ledger, expenses are editable by admins — but an
// edit never changes `incurredAt`, so the year an expense lands in the
// income/expense report is fixed at recording time.
//
// `capital` is deliberately its own flag, independent of `category`: a
// Repairs expense can be either routine (operating) or a capital
// investment. Do not model capital-vs-operating as a category.
model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory
  capital     Boolean         @default(false)
  incurredAt  DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Logical link to the identity DB's users.id (no cross-database FK), plus a
  // denormalized snapshot of the recording admin's name/email captured at
  // write time — same pattern as Transaction.createdById/createdByName/
  // createdByEmail (named createdByUserId here per this model's own
  // convention, not createdById).
  createdByUserId String
  createdByName   String?
  createdByEmail  String?

  @@index([incurredAt])
}

// One row per calendar year: the family's contribution goal, shown as the
// dashboard progress tracker. Admin-editable.
model ContributionGoal {
  year      Int      @id
  amount    Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt
}

// Single-row app configuration (id is always "singleton"). Typed columns
// rather than key-value so the generated client keeps settings type-safe;
// future settings are one migration each.
model AppSettings {
  id String @id @default("singleton")

  // When false, the Contributions tab is admins-only: non-admin
  // shareholders don't see it and its page redirects them away.
  contributionsVisibleToAll Boolean @default(true)

  updatedAt DateTime @updatedAt
}
