# Neon Postgres — this app's own business data (mfr-accounting project).
# Pooled connection (runtime) and direct connection (Prisma migrations).
DATABASE_URL=
DIRECT_URL=

# Shared identity database (@mfr/auth) — MUST be the same value the reservations
# app uses, so both apps share one set of users/sessions.
IDENTITY_DATABASE_URL=
IDENTITY_DIRECT_DATABASE_URL=

# Auth.js. AUTH_SECRET must be the IDENTICAL string across every mfr app for
# shared database-strategy sessions. Generate with: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3000/accounting/api/auth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Cross-app SSO cookie domain (e.g. .millerfamilyreunions.org). Leave blank
# until the routing strategy is decided — host-only cookies work locally.
AUTH_COOKIE_DOMAIN=

# Amazon SES (transactional email). AWS_* names are reserved by Vercel, so the
# credentials use SES_-prefixed names. The IAM user needs ses:SendEmail on a
# verified @millerfamilyreunions.org sender.
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Verified SES sender, e.g. accounting@millerfamilyreunions.org
EMAIL_FROM=
# Set EMAIL_ENABLED=true ONLY in production — it lets sendEmail() deliver to
# real recipients. Leave it unset everywhere else.
EMAIL_ENABLED=
# In non-prod (EMAIL_ENABLED unset), all mail is redirected to a plus
# sub-address of this inbox so real members are never emailed from dev, while
# the original recipient stays visible: a message for dbrown@gmail.com with
# EMAIL_OVERRIDE_TO=me@gmail.com is sent to me+dbrown=gmail.com@gmail.com (all
# land in me@gmail.com). Needs a "+"-addressing inbox (Gmail). Blank in prod.
EMAIL_OVERRIDE_TO=

APP_BASE_URL=http://localhost:3000/accounting
