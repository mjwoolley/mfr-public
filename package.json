{
  "name": "mfr",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/mfr",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.e2e.json",
    "test": "npm run test --workspaces --if-present",
    "test:smoke": "node --test scripts/*.test.mjs",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:coverage:unit": "npm run test:coverage:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:mutation": "npm run test:mutation --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:preview": "playwright test --config playwright.preview.config.ts",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "sharp": "^0.34.5",
    "shell-quote": "^1.10.0",
    "fast-uri": "^3.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.5"
  }
}
