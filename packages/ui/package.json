{
  "name": "@mfr/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./organic.css": "./src/organic.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
